<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Two groups, least privilege: this app's own, for the backend credential, and the push
	     group shared with the notification service extension, which reads each server's content
	     key from there while the phone is locked. A Keychain access group needs only a shared
	     team, so no App Group is involved. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.frederikberg.mailverdict</string>
		<string>$(AppIdentifierPrefix)com.frederikberg.mailverdict.push</string>
	</array>
</dict>
</plist>
