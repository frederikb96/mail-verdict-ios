# What the simulator scripts need to know about this app.
PROJECT=MailVerdict.xcodeproj
SCHEME=MailVerdict
BUNDLE=com.frederikberg.mailverdict

after_boot() {
  xcrun simctl ui "$1" appearance "${APPEARANCE:-dark}"
  # The keyboard's one-time "slide to type" introduction covers the bottom third of the screen the
  # first time a text field is focused, exactly where search-with-results' own results sit.
  xcrun simctl spawn "$1" defaults write com.apple.keyboard.preferences \
    DidShowContinuousPathIntroduction -bool true
  # The boundary "Collect crash reports" reads; a timestamp this job minted is exactly the right
  # one, and `find -newermt` takes nothing portable on BSD find.
  touch /tmp/mac-sweep-start-marker
}

after_install() { :; }
