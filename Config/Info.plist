<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- A bare IP or unqualified hostname on a LAN is exactly what a self-hoster's own backend is
         reached by, and ATS otherwise requires HTTPS for every connection regardless of locality.
         `NSAllowsLocalNetworking` lifts the HTTPS requirement for local-network destinations
         specifically (loopback, bare IPs, `.local` names) without the blanket
         `NSAllowsArbitraryLoads` exception — it does not relax certificate trust, so HTTPS to a
         Tailscale host still needs a certificate the device trusts (`tailscale cert` gives one). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- The server's silent read-sync push wakes the app to withdraw notifications read
         elsewhere and correct the badge. Without this key it is never delivered at all. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>
